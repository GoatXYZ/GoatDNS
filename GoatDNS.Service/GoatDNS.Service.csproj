<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>GoatDNS.Service</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!-- PipeSecurity / NamedPipeServerStreamAcl (for the LocalSystem pipe ACL) are provided
         automatically by the net10.0-windows framework — no explicit package needed. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoatDNS.Core\GoatDNS.Core.csproj" />
    <ProjectReference Include="..\GoatDNS.Ebpf\GoatDNS.Ebpf.csproj" />
  </ItemGroup>

</Project>
