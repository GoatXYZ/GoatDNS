<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GoatDNS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="GoatDNS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Banners -->
        <StackPanel Grid.Row="0" Spacing="0">
            <InfoBar
                IsOpen="{x:Bind ViewModel.ServiceDown, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Title="Service not running"
                Message="The GoatDNS background service isn't reachable. Start it to view or change settings." />
            <InfoBar
                x:Name="ErrorBar"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Title="Something went wrong"
                Message="{x:Bind ViewModel.LastError, Mode=OneWay}"
                CloseButtonClick="ErrorBar_CloseButtonClick" />
        </StackPanel>

        <!-- Navigation + page host -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Servers" Tag="Servers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Pools" Tag="Pools">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Rules" Tag="Rules">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE14C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Hosts" Tag="Hosts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE130;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Log" Tag="Log">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE119;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Options" Tag="Options">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Status bar -->
        <Border
            Grid.Row="2"
            Padding="12,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind ViewModel.StatusSummary, Mode=OneWay}" />

                <ProgressRing
                    Grid.Column="1"
                    Width="18" Height="18"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <Button
                    Grid.Column="2"
                    Content="{x:Bind ViewModel.InterceptionMenuLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleInterceptionCommand}" />

                <Button
                    Grid.Column="3"
                    Content="Reload"
                    Command="{x:Bind ViewModel.ReloadCommand}" />

                <Button
                    Grid.Column="4"
                    Content="Apply"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ApplyCommand}" />
            </Grid>
        </Border>

        <!-- Tray icon (non-visual). Lives in the window tree so its generated icon has a XamlRoot. -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            Grid.Row="2"
            ToolTipText="GoatDNS"
            ContextMenuMode="SecondWindow"
            LeftClickCommand="{x:Bind ShowFromTrayCommand}">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="G" Foreground="White" Background="#2E7D32" FontSize="28" FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Text="{x:Bind ViewModel.InterceptionMenuLabel, Mode=OneWay}"
                        Click="TrayToggle_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Open" Click="TrayOpen_Click" />
                    <MenuFlyoutItem Text="Exit" Click="TrayExit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
