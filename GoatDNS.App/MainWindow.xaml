<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GoatDNS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="GoatDNS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Banners -->
        <StackPanel Grid.Row="0" Spacing="0">
            <InfoBar
                IsOpen="{x:Bind ViewModel.ServiceDown, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Title="Service not running"
                Message="The GoatDNS background service isn't reachable. Start it to view or change settings." />
            <InfoBar
                x:Name="ErrorBar"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Title="Something went wrong"
                Message="{x:Bind ViewModel.LastError, Mode=OneWay}"
                CloseButtonClick="ErrorBar_CloseButtonClick" />
        </StackPanel>

        <!-- Top command bar: the always-visible global actions (interception toggle, reload, apply). -->
        <Border
            Grid.Row="1"
            Padding="12,8"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Column 0 is intentionally empty: no status readout, actions keep to the right. -->
                <ProgressRing
                    Grid.Column="1"
                    Width="18" Height="18"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <Button
                    Grid.Column="2"
                    MinWidth="150"
                    Content="{x:Bind ViewModel.InterceptionMenuLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleInterceptionCommand}"
                    ToolTipService.ToolTip="Turn system-wide DNS interception on or off. Off = your normal DNS is used; nothing else changes." />

                <Button
                    Grid.Column="3"
                    Content="Reload"
                    Command="{x:Bind ViewModel.ReloadCommand}"
                    ToolTipService.ToolTip="Discard unapplied edits and re-read the configuration the service is currently running." />

                <Button
                    Grid.Column="4"
                    Content="Apply"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ApplyCommand}"
                    ToolTipService.ToolTip="Push your edits (servers, pools, rules, options) to the service. Changes take effect immediately and are saved." />
            </Grid>
        </Border>

        <!-- Navigation + page host -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Servers" Tag="Servers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Pools" Tag="Pools">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Rules" Tag="Rules">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE14C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Hosts" Tag="Hosts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE130;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Log" Tag="Log">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE119;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Options" Tag="Options">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Quit sits at the very bottom of the pane, away from the page list and the Apply button. -->
            <NavigationView.PaneFooter>
                <Button
                    Margin="4,4,4,8"
                    Padding="12,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.QuitCommand}"
                    ToolTipService.ToolTip="Stop the service / interception and close GoatDNS">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                        <TextBlock Text="Quit" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Tray icon (non-visual). Lives in the window tree so its generated icon has a XamlRoot. -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            Grid.Row="2"
            ToolTipText="{x:Bind ViewModel.StatusSummary, Mode=OneWay}"
            IconSource="/Assets/goatdns-app-icon.ico"
            ContextMenuMode="SecondWindow"
            LeftClickCommand="{x:Bind ShowFromTrayCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Text="{x:Bind ViewModel.InterceptionMenuLabel, Mode=OneWay}"
                        Click="TrayToggle_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Open" Click="TrayOpen_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Quit (stop service &amp; exit)" Click="TrayQuit_Click" />
                    <MenuFlyoutItem Text="Exit (leave service running)" Click="TrayExit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
