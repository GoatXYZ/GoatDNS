<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GoatDNS.App.Dialogs.PoolEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GoatDNS.App.ViewModels"
    Title="Pool"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Width="420" Spacing="10">
        <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />

        <ComboBox
            Header="Strategy"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind ViewModel.StrategyOptions}"
            SelectedItem="{x:Bind ViewModel.Strategy, Mode=TwoWay}" />

        <TextBlock Text="Members" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock
            Text="No servers defined yet — add them on the Servers page first."
            Opacity="0.7"
            TextWrapping="Wrap"
            Visibility="{x:Bind HasNoChoices, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.ServerChoices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableItem">
                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
