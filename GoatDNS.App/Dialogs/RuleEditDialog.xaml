<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GoatDNS.App.Dialogs.RuleEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GoatDNS.App.ViewModels"
    Title="Rule"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Width="460" Spacing="10">
            <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
            <ToggleSwitch Header="Enabled" IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />

            <TextBox
                Header="Host patterns (one per line, e.g. *.example.com)"
                AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                Text="{x:Bind ViewModel.HostsText, Mode=TwoWay}" />

            <TextBlock Text="Hosts files that also select this rule" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.HostsFileChoices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableItem">
                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox
                Header="Process patterns (one per line, e.g. chrome*)"
                AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                Text="{x:Bind ViewModel.ProcessesText, Mode=TwoWay}" />

            <TextBox Header="Interface name (optional)" Text="{x:Bind ViewModel.InterfaceName, Mode=TwoWay}" />
            <CheckBox Content="Ignore this rule when the interface is down" IsChecked="{x:Bind ViewModel.IgnoreWhenInterfaceDown, Mode=TwoWay}" />

            <ComboBox
                Header="Action"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.ActionOptions}"
                SelectedItem="{x:Bind ViewModel.Action, Mode=TwoWay}" />

            <ComboBox
                Header="Pool or server"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.PoolTargets}"
                SelectedItem="{x:Bind ViewModel.Pool, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.ShowPool, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ComboBox
                Header="DNSSEC"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.DnssecOptions}"
                SelectedItem="{x:Bind ViewModel.Dnssec, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
