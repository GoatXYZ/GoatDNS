<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoatDNS.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GoatDNS.App.ViewModels">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Rules" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Add" Click="Add_Click" />
            <Button Content="Edit" Click="Edit_Click" />
            <Button Content="Delete" Command="{x:Bind ViewModel.DeleteCommand}" />
            <AppBarSeparator />
            <Button Command="{x:Bind ViewModel.MoveUpCommand}" ToolTipService.ToolTip="Move up">
                <FontIcon Glyph="&#xE70E;" />
            </Button>
            <Button Command="{x:Bind ViewModel.MoveDownCommand}" ToolTipService.ToolTip="Move down">
                <FontIcon Glyph="&#xE70D;" />
            </Button>
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Opacity="0.7"
            TextWrapping="Wrap"
            Text="Rules are evaluated top-to-bottom. The last rule is the catch-all default and stays pinned last." />

        <ListView
            Grid.Row="3"
            SelectionMode="Single"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
            DoubleTapped="List_DoubleTapped"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleItemViewModel">
                    <Grid Padding="4,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" MinWidth="0" IsChecked="{x:Bind Enabled, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Summary, Mode=OneWay}" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
