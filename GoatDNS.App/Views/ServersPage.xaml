<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoatDNS.App.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GoatDNS.App.ViewModels">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Servers" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Add" Click="Add_Click" />
            <Button Content="Edit" Click="Edit_Click" />
            <Button Content="Delete" Command="{x:Bind ViewModel.DeleteCommand}" />
            <AppBarSeparator />
            <Button Content="Test" Command="{x:Bind ViewModel.TestSelectedCommand}" />
            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Import: from an sdns:// stamp, or from the bundled (vendored + rehosted) resolver lists -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox
                    Width="460"
                    PlaceholderText="sdns://…"
                    Text="{x:Bind ViewModel.StampInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Import from stamp" Command="{x:Bind ViewModel.ImportStampCommand}" VerticalAlignment="Bottom" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Import starter list" Command="{x:Bind ViewModel.ImportStarterCommand}" />
                <Button Content="Import public resolvers" Command="{x:Bind ViewModel.ImportPublicResolversCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="4">
            <InfoBar
                IsOpen="{x:Bind ViewModel.ResultShowInfo, Mode=OneWay}"
                IsClosable="True"
                Severity="Success"
                Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.ResultShowError, Mode=OneWay}"
                IsClosable="True"
                Severity="Error"
                Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- Columned table: Name · Protocol · Address/URL. -->
        <Border Grid.Row="4" BorderThickness="1" CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="12"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource ColumnHeaderTextStyle}" />
                    <TextBlock Grid.Column="1" Text="Protocol" Style="{StaticResource ColumnHeaderTextStyle}" />
                    <TextBlock Grid.Column="2" Text="Address / URL" Style="{StaticResource ColumnHeaderTextStyle}" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    SelectionMode="Single"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    DoubleTapped="List_DoubleTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerItemViewModel">
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ProtocolLabel, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Endpoint, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
