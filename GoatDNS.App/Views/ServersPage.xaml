<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoatDNS.App.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GoatDNS.App.ViewModels">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Servers" Style="{StaticResource TitleTextBlockStyle}" />

        <!-- One compact command row: actions on the left, live filter on the right. -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="Add" Click="Add_Click" />
                <Button Content="Edit" Click="Edit_Click" />
                <Button Content="Delete" Command="{x:Bind ViewModel.DeleteCommand}" />
                <AppBarSeparator />
                <Button Content="Test" Command="{x:Bind ViewModel.TestSelectedCommand}" />
                <Button Content="Test all" Command="{x:Bind ViewModel.TestAllCommand}" />
                <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}" VerticalAlignment="Center" />
                <AppBarSeparator />
                <DropDownButton Content="Import">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="From sdns:// stamp…" Click="ImportStamp_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Starter list" Command="{x:Bind ViewModel.ImportStarterCommand}" />
                            <MenuFlyoutItem Text="Public resolvers" Command="{x:Bind ViewModel.ImportPublicResolversCommand}" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <TextBox
                Grid.Column="1"
                Width="260"
                PlaceholderText="Filter servers…"
                Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="4">
            <InfoBar
                IsOpen="{x:Bind ViewModel.ResultShowInfo, Mode=OneWay}"
                IsClosable="True"
                Severity="Success"
                Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.ResultShowError, Mode=OneWay}"
                IsClosable="True"
                Severity="Error"
                Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- Columned, sortable table (click a header to sort). Rows are green/red after a Test. -->
        <Border Grid.Row="3" BorderThickness="1" CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="12"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ColumnHeaderButtonStyle}"
                            Content="{x:Bind ViewModel.NameHeader, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Name" />
                    <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButtonStyle}"
                            Content="{x:Bind ViewModel.ProtocolHeader, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Protocol" />
                    <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButtonStyle}"
                            Content="{x:Bind ViewModel.EndpointHeader, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Endpoint" />
                    <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButtonStyle}"
                            Content="{x:Bind ViewModel.CheckHeader, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Check" />
                </Grid>

                <ListView
                    x:Name="ServerList"
                    Grid.Row="1"
                    SelectionMode="Extended"
                    ItemsSource="{x:Bind ViewModel.Visible}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionChanged="List_SelectionChanged"
                    DoubleTapped="List_DoubleTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerItemViewModel">
                            <!-- Transparent background so the whole row (not just the text) is right-clickable. -->
                            <Grid Padding="12,8" ColumnSpacing="12" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Edit…" Click="RowEdit_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Test" Click="RowTest_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D2;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Delete" Click="RowDelete_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{x:Bind HealthBrush, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ProtocolLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="{x:Bind HealthBrush, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Endpoint, Mode=OneWay}" VerticalAlignment="Center" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Foreground="{x:Bind HealthBrush, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind CheckText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{x:Bind HealthBrush, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
