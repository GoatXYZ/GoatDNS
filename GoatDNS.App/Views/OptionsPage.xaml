<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoatDNS.App.Views.OptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Options" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <InfoBar IsOpen="{x:Bind ViewModel.StatusShowInfo, Mode=OneWay}" IsClosable="True" Severity="Success" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                <InfoBar IsOpen="{x:Bind ViewModel.StatusShowError, Mode=OneWay}" IsClosable="True" Severity="Error" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>

            <!-- Interception -->
            <TextBlock Text="Interception" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ToggleSwitch Header="Enabled (persisted default)" IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
            <NumberBox
                Header="Listen port"
                Minimum="1" Maximum="65535"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.ListenPortValue, Mode=TwoWay}" />
            <ComboBox
                Header="Block response"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.BlockResponseOptions}"
                SelectedItem="{x:Bind ViewModel.BlockResponse, Mode=TwoWay}" />

            <!-- Logging -->
            <TextBlock Text="Logging" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ComboBox
                Header="Screen verbosity"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.VerbosityOptions}"
                SelectedItem="{x:Bind ViewModel.ScreenVerbosity, Mode=TwoWay}" />
            <ComboBox
                Header="File verbosity"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.VerbosityOptions}"
                SelectedItem="{x:Bind ViewModel.FileVerbosity, Mode=TwoWay}" />
            <TextBox Header="Log file path (optional)" Text="{x:Bind ViewModel.LogFilePath, Mode=TwoWay}" />
            <Button Content="Browse…" Click="BrowseLog_Click" />

            <!-- Interception mode -->
            <TextBlock Text="Interception mode" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Running as:" VerticalAlignment="Center" Opacity="0.7" />
                <TextBlock Text="{x:Bind ViewModel.Main.ModeLabel, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
            <Button Content="Run in DNS mode (this app, elevated)"
                    Command="{x:Bind ViewModel.Main.StartDnsModeCommand}"
                    IsEnabled="{x:Bind ViewModel.Main.CanStartDnsMode, Mode=OneWay}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="DNS mode runs interception inside this app (no background service) while it's open — this is the default when you launch elevated. The Windows service below is the always-on / works-without-login option." />

            <!-- Windows service -->
            <TextBlock Text="Windows service" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="State:" VerticalAlignment="Center" Opacity="0.7" />
                <TextBlock Text="{x:Bind ViewModel.Main.ServiceStateText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Start" Command="{x:Bind ViewModel.Main.StartServiceCommand}"
                        IsEnabled="{x:Bind ViewModel.Main.ServiceInstalled, Mode=OneWay}" />
                <Button Content="Stop" Command="{x:Bind ViewModel.Main.StopServiceCommand}"
                        IsEnabled="{x:Bind ViewModel.Main.ServiceRunning, Mode=OneWay}" />
                <Button Content="Restart" Command="{x:Bind ViewModel.Main.RestartServiceCommand}"
                        IsEnabled="{x:Bind ViewModel.Main.ServiceInstalled, Mode=OneWay}" />
                <Button Content="Install" Command="{x:Bind ViewModel.Main.InstallServiceCommand}" />
                <Button Content="Uninstall" Command="{x:Bind ViewModel.Main.UninstallServiceCommand}"
                        IsEnabled="{x:Bind ViewModel.Main.ServiceInstalled, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Service actions need administrator rights — you'll get a UAC prompt if the app isn't elevated." />

            <!-- Startup -->
            <TextBlock Text="Startup" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ToggleSwitch Header="Start GoatDNS with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />

            <!-- Config file -->
            <TextBlock Text="Configuration file" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Import…" Click="Import_Click" />
                <Button Content="Export…" Click="Export_Click" />
            </StackPanel>
            <TextBlock
                Opacity="0.7"
                TextWrapping="Wrap"
                Text="Import loads a config into the editor; it isn't sent to the service until you Apply." />
        </StackPanel>
    </ScrollViewer>
</Page>
