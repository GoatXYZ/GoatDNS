<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoatDNS.App.Views.HostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GoatDNS.App.ViewModels">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Hosts files" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Add" Command="{x:Bind ViewModel.AddCommand}" />
            <Button Content="Delete" Command="{x:Bind ViewModel.DeleteCommand}" />
            <AppBarSeparator />
            <Button Content="Reload from disk" Command="{x:Bind ViewModel.ReloadCommand}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ListView
                Grid.Column="0"
                SelectionMode="Single"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HostsItemViewModel">
                        <StackPanel Padding="4,6">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Inline editor for the selected entry. IsEnabled lives on a ContentControl because
                 StackPanel (a Panel, not a Control) has no IsEnabled in WinUI. -->
            <ContentControl Grid.Column="1" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            HorizontalContentAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBox Header="Name" Text="{x:Bind ViewModel.Selected.Name, Mode=TwoWay}" />

                    <TextBox Header="Path" IsReadOnly="True" Text="{x:Bind ViewModel.Selected.Path, Mode=OneWay}" />
                    <Button Content="Browse…" Click="Browse_Click" />

                    <ComboBox
                        Header="Mode"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ModeOptions}"
                        SelectedItem="{x:Bind ViewModel.Selected.Mode, Mode=TwoWay}" />
                </StackPanel>
            </ContentControl>
        </Grid>
    </Grid>
</Page>
