<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoatDNS.App.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Live log" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <ComboBox
                Header="Show up to"
                MinWidth="140"
                ItemsSource="{x:Bind ViewModel.VerbosityOptions}"
                SelectedItem="{x:Bind ViewModel.MaxLevel, Mode=TwoWay}" />
            <ToggleButton Content="Pause" IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}" VerticalAlignment="Bottom" />
            <Button Content="Copy" Click="Copy_Click" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Copy the selection, or the whole log if nothing is selected" />
            <Button Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" VerticalAlignment="Bottom" />
            <TextBox
                PlaceholderText="Filter…"
                Width="260"
                VerticalAlignment="Bottom"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- RichTextBlock (not a ListView) so log text is selectable and copyable. Rows are mirrored
             from the view-model into Blocks in code-behind; colouring is per-line. -->
        <Border
            Grid.Row="2"
            BorderThickness="1"
            CornerRadius="4"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer
                x:Name="LogScroll"
                Padding="10,8"
                HorizontalScrollMode="Auto"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <RichTextBlock
                    x:Name="LogText"
                    IsTextSelectionEnabled="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    FontSize="13"
                    LineHeight="18" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
