<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoatDNS.App.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GoatDNS.App.ViewModels">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Live log" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <ComboBox
                Header="Show up to"
                MinWidth="140"
                ItemsSource="{x:Bind ViewModel.VerbosityOptions}"
                SelectedItem="{x:Bind ViewModel.MaxLevel, Mode=TwoWay}" />
            <ToggleButton Content="Pause" IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}" VerticalAlignment="Bottom" />
            <Button Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" VerticalAlignment="Bottom" />
            <TextBox
                PlaceholderText="Filter…"
                Width="260"
                VerticalAlignment="Bottom"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <ListView
            x:Name="LogList"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            FontFamily="Consolas"
            ScrollViewer.HorizontalScrollMode="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="8,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LogRow">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Time}" Opacity="0.6" />
                        <TextBlock Grid.Column="1" Width="80" Text="{x:Bind Level}" Foreground="{x:Bind Level, Converter={StaticResource LogLevelToBrush}}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Message}" Foreground="{x:Bind Level, Converter={StaticResource LogLevelToBrush}}" TextWrapping="NoWrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
