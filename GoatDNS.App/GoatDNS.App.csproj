<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GoatDNS.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Unpackaged so the unelevated UI can open the service's named pipe without MSIX identity friction. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Ship the WinAppSDK runtime with the app so an unpackaged install has no external prerequisite. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Windows-only product; platform-guard analyzer noise isn't actionable here (matches Core/Service). -->
    <!-- MVVMTK0045: [ObservableProperty]-on-field AOT advisory; we don't ship NativeAOT, so it's noise. -->
    <NoWarn>$(NoWarn);CA1416;MVVMTK0045</NoWarn>
    <!-- Custom entry point (Program.cs) so we can run the elevated service helper before booting WinUI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vendored + rehosted resolver lists, bundled so imports work fully offline. -->
    <Content Include="..\resolvers\*.md" Link="resolvers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoatDNS.Core\GoatDNS.Core.csproj" />
  </ItemGroup>

</Project>
